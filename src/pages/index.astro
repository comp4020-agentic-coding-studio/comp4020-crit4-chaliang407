---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Orbit"
  description="Orbit: a single-gesture browser instrument. Touch and drag to play."
>
  <div id="instrument">
    <div id="ambient" aria-hidden="true">
      <div class="glow glow-a"></div>
      <div class="glow glow-b"></div>
      <div class="ring ring-1"></div>
      <div class="ring ring-2"></div>
      <div class="ring ring-3"></div>
      <div class="stars stars-far"></div>
      <div class="stars stars-near"></div>
    </div>

    <div id="intro">
      <h1 id="title">Orbit</h1>
      <p id="tagline">Draw your sound</p>
      <p id="hint">touch · drag · listen</p>
    </div>

    <div id="orb-layer" aria-hidden="true"></div>
  </div>

  <script>
    import { initOrbit } from "../scripts/orbit";
    initOrbit();
  </script>
</BaseLayout>

<style>
  #instrument {
    position: fixed;
    inset: 0;
    touch-action: none;
    overflow: hidden;
  }

  /*
    A single custom property drives the whole background: JS sets --glow to
    the same 0..1 brightness used for the audio filter, so the space itself
    dims and lifts with vertical drag instead of only the timbre changing.
    @property makes an otherwise-opaque custom property transition smoothly,
    so releasing back to the resting brightness fades rather than jumps.
  */
  @property --glow {
    syntax: "<number>";
    inherits: true;
    initial-value: 0.35;
  }

  #instrument::before {
    content: "";
    position: absolute;
    inset: -25%;
    background: radial-gradient(ellipse at center, #1b3a5c 0%, #04070d 65%);
    filter: brightness(calc(0.65 + var(--glow) * 0.9));
    transition: filter 0.5s ease;
  }

  /*
    Ambient decoration: soft glows, slowly-orbiting rings, and a faint
    starfield, so the space reads as a place before anyone has touched it.
    Everything here is pointer-events: none (inherited by its children) so
    it never steals a gesture from #instrument, and it sits behind #intro
    and #orb-layer in paint order (DOM order, all default z-index) so real
    feedback always shows clearly above it.
  */
  #ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    transform: translate(calc(var(--px, 0) * 16px), calc(var(--py, 0) * 16px));
    transition: transform 0.6s ease-out;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.35;
    mix-blend-mode: screen;
  }

  .glow-a {
    top: 8%;
    left: 10%;
    width: 55vmin;
    height: 55vmin;
    background: radial-gradient(circle, rgb(120 170 255 / 50%), transparent 70%);
  }

  .glow-b {
    right: 12%;
    bottom: 10%;
    width: 46vmin;
    height: 46vmin;
    background: radial-gradient(circle, rgb(180 140 255 / 40%), transparent 70%);
  }

  .ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    border: 1px solid rgb(191 232 255 / 8%);
    transform: translate(-50%, -50%);
  }

  /* A single faint dot per ring is what makes the slow rotation visible ---
     an orbit, not just a static circle. */
  .ring::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    width: 3px;
    height: 3px;
    margin-left: -1.5px;
    border-radius: 50%;
    background: rgb(191 232 255 / 50%);
    box-shadow: 0 0 6px 1px rgb(191 232 255 / 35%);
  }

  .ring-1 {
    width: 46vmin;
    height: 46vmin;
    animation: ring-spin 90s linear infinite;
  }

  .ring-2 {
    width: 72vmin;
    height: 72vmin;
    border-color: rgb(191 232 255 / 6%);
    animation: ring-spin 150s linear infinite reverse;
  }

  .ring-3 {
    width: 98vmin;
    height: 98vmin;
    border-color: rgb(191 232 255 / 4%);
    animation: ring-spin 220s linear infinite;
  }

  @keyframes ring-spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  .stars {
    position: absolute;
    inset: -10%;
    background-repeat: repeat;
  }

  .stars-far {
    background-image: radial-gradient(circle, rgb(255 255 255 / 55%) 1px, transparent 1.6px);
    background-size: 180px 180px;
    opacity: 0.3;
  }

  .stars-near {
    background-image: radial-gradient(circle, rgb(255 255 255 / 70%) 1px, transparent 1.4px);
    background-size: 90px 90px;
    background-position: 40px 60px;
    opacity: 0.2;
  }

  #intro {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
    transition:
      opacity 1s ease,
      transform 1s ease;
  }

  #intro.is-hidden {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.94);
  }

  #title {
    margin: 0;
    padding-left: 0.35em; /* optical balance for the letter-spacing on the right */
    color: #eaf6ff;
    font-family: system-ui, sans-serif;
    font-size: clamp(3rem, 13vw, 7rem);
    font-weight: 200;
    letter-spacing: 0.35em;
    text-shadow:
      0 0 40px rgb(191 232 255 / 45%),
      0 0 90px rgb(120 170 255 / 25%);
  }

  #tagline {
    margin: 0;
    padding-left: 0.4em;
    color: rgb(191 232 255 / 65%);
    font-family: system-ui, sans-serif;
    font-size: clamp(0.85rem, 2vw, 1.1rem);
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  #hint {
    margin: 0;
    color: rgb(255 255 255 / 40%);
    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
  }

  #orb-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  #orb-layer :global(.orb) {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: #bfe8ff;
    box-shadow: 0 0 20px 6px rgb(191 232 255 / 60%);
    opacity: 0;
    transform: scale(0.4);
    transition:
      left 0.06s linear,
      top 0.06s linear,
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  #orb-layer :global(.orb.is-active) {
    opacity: 1;
    transform: scale(1);
  }

  /* Onset: a bigger ring once, when a gesture begins. */
  #orb-layer :global(.ripple) {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    border: 1px solid rgb(191 232 255 / 70%);
    animation: ripple-expand 0.8s ease-out forwards;
  }

  @keyframes ripple-expand {
    from {
      transform: scale(0.3);
      opacity: 0.8;
    }

    to {
      transform: scale(9);
      opacity: 0;
    }
  }

  /* Path: a small dot left behind every so often while dragging. */
  #orb-layer :global(.trail) {
    position: absolute;
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 50%;
    background: rgb(191 232 255 / 45%);
    box-shadow: 0 0 10px 2px rgb(191 232 255 / 25%);
    animation: trail-fade 900ms ease-out forwards;
  }

  @keyframes trail-fade {
    from {
      transform: scale(1);
      opacity: 0.7;
    }

    to {
      transform: scale(0.3);
      opacity: 0;
    }
  }

  /* Pitch change: a smaller, quieter ring than the onset ripple, so it reads
     as a note-change tick rather than another gesture starting. */
  #orb-layer :global(.pulse) {
    position: absolute;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    border: 1px solid rgb(191 232 255 / 55%);
    animation: pulse-expand 700ms ease-out forwards;
  }

  @keyframes pulse-expand {
    from {
      transform: scale(0.4);
      opacity: 0.9;
    }

    to {
      transform: scale(5);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring {
      animation: none;
    }

    #ambient {
      transition: none;
    }

    #orb-layer :global(.orb),
    #orb-layer :global(.ripple),
    #orb-layer :global(.trail),
    #orb-layer :global(.pulse) {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
